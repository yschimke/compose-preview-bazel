module(
    name = "rules_compose_preview",
    version = "0.1.0-rc.8",  # x-release-please-version
    compatibility_level = 1,
)

# bzl_library targets in BUILD.bazel. rules_java 9.3.0 already requires this version.
bazel_dep(name = "bazel_skylib", version = "1.6.1")
bazel_dep(name = "rules_java", version = "9.3.0")

# The Bash runfiles library the run launchers source (launcher.bzl). Bazel 9's own bazel_tools
# depends on this version, so it upgrades no consumer there.
bazel_dep(name = "rules_shell", version = "0.6.1")

# Only android.bzl loads rules_android. 0.6.6 is the oldest release whose
# StarlarkAndroidResourcesInfo carries every field the Android aspect reads, so a
# consumer's own rules_android is not upgraded by this module.
bazel_dep(name = "rules_android", version = "0.6.6")
