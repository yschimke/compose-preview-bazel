load("@rules_android//rules:rules.bzl", "android_library")

# A sibling of //ui on the same theme: the CLI links the two into one resource APK.
android_library(
    name = "feature",
    srcs = glob(["src/**/*.java"]),
    assets = glob(["assets/**"]),
    assets_dir = "assets",
    custom_package = "com.example.feature",
    manifest = "AndroidManifest.xml",
    resource_files = glob(["res/**"]),
    deps = ["//theme"],
)
